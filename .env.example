# ===========================================================
# NeuroScreen — Environment Variables
# ===========================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to version control.
# ===========================================================

# --- Supabase ---
# Project URL from your Supabase dashboard (Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co

# Anon/public key — safe to expose in frontend (RLS enforces security)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Service-role key — BACKEND ONLY, never expose in frontend code
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT secret — used by FastAPI to verify Supabase-issued JWTs
# Found in Supabase dashboard: Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- FastAPI Backend ---
# Backend server configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_ENV=development

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend (Vite) ---
# Vite requires VITE_ prefix for client-exposed variables
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=http://localhost:8000

# --- ML Model ---
# Path to the trained model file (relative to backend/)
ML_MODEL_PATH=ml/models/best_model.joblib
ML_MODEL_METADATA_PATH=ml/models/model_metadata.json

# --- Speech-to-Text (Vosk) ---
# Path to Vosk language model directory
VOSK_MODEL_PATH_EN=ml/models/vosk-model-small-en-us
VOSK_MODEL_PATH_KN=ml/models/vosk-model-small-kn

# --- Rate Limiting ---
# Max requests per minute for auth endpoints
RATE_LIMIT_AUTH=20
# Max requests per minute for prediction endpoints
RATE_LIMIT_PREDICT=10
